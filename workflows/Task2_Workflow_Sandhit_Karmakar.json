      "id": "b1a10003-1111-4111-8111-000000000003",
      "name": "1. Fetch Trending GitHub Repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        320
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-github-header-auth",
          "name": "GitHub REST API Token (Header Auth)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Filter, calculate composite velocity score, sort descending, and keep Top 5 repositories\nconst rawResponse = $input.first()?.json;\nconst items = Array.isArray(rawResponse?.items) ? rawResponse.items : [];\n\nif (items.length === 0) {\n  throw new Error('GitHub Search API returned zero repository items or malformed payload.');\n}\n\nconst filteredAndScored = items\n  .filter(repo => !repo.archived && !repo.disabled && repo.description)\n  .map(repo => {\n    const stars = Number(repo.stargazers_count || 0);\n    const forks = Number(repo.forks_count || 0);\n    const openIssues = Number(repo.open_issues_count || 0);\n    // Composite traction metric weighting stars, active forks, and issue discussions\n    const velocityScore = stars + (forks * 2) + Math.min(openIssues, 200);\n    return {\n      repo_id: repo.id,\n      name: repo.name,\n      full_name: repo.full_name,\n      owner: repo.owner?.login || 'unknown',\n      stars,\n      forks,\n      open_issues: openIssues,\n      velocity_score: velocityScore,\n      language: repo.language || 'Multi-language',\n      license: repo.license?.spdx_id || 'Unspecified',\n      description: repo.description.slice(0, 220),\n      html_url: repo.html_url,\n      pushed_at: repo.pushed_at\n    };\n  })\n  .sort((a, b) => b.velocity_score - a.velocity_score)\n  .slice(0, 5)\n  .map((repo, idx) => ({\n    json: {\n      rank: idx + 1,\n      ...repo\n    }\n  }));\n\nreturn filteredAndScored;"
      },
      "id": "b1a10004-1111-4111-8111-000000000004",
      "name": "2. Filter, Sort & Keep Top 5 (Code)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        260
      ]
    },
    {

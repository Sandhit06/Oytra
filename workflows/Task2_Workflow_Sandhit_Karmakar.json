    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Standardized Error Sanitizer & Fallback Formatter (Prevents Silent Crashes)\nconst errItem = $input.first()?.json || {};\nconst errorMsg = errItem.error?.message || errItem.message || 'Upstream API returned non-200 status or timed out';\nconst statusCode = errItem.error?.httpCode || errItem.statusCode || 503;\n\nreturn [\n  {\n    json: {\n      status: 'FALLBACK_TRIGGERED',\n      workflow_name: 'Task 2 \u2014 Daily AI & Automation Morning Brief',\n      failed_at: new Date().toISOString(),\n      http_code: statusCode,\n      error_detail: errorMsg,\n      remediation: 'Check GitHub API rate limit (X-RateLimit-Remaining) or credentials in n8n Credential Store.'\n    }\n  }\n];"
      },

    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://hn.algolia.com/api/v1/search?query={{ encodeURIComponent($('2. Filter, Sort & Keep Top 5 (Code)').item.json.name) }}&tags=story&hitsPerPage=3",
        "options": {
          "timeout": 8000
        }
      },
      "id": "b1a10006-1111-4111-8111-000000000006",
      "name": "3b. Enrich: HackerNews Sentiment API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Combine Top-5 repo data + decoded GitHub README excerpt + HackerNews discussion signal\nconst baseRepo = $('2. Filter, Sort & Keep Top 5 (Code)').item.json;\nconst readmeNode = $('3a. Enrich: Fetch Repo README API').item?.json || {};\nconst hnNode = $input.item?.json || {};\n\n// Decode Base64 README content from GitHub API and strip markdown badges/headers\nlet readmeExcerpt = 'README summary unavailable.';\nif (readmeNode.content) {\n  try {\n    const rawText = Buffer.from(readmeNode.content, 'base64').toString('utf-8');\n    const cleanLines = rawText\n      .split('\\n')\n      .map(line => line.replace(/!\\[.*?\\]\\(.*?\\)/g, '').replace(/<[^>]+>/g, '').trim())\n      .filter(line => line.length > 30 && !line.startsWith('#') && !line.startsWith('[!'));\n    if (cleanLines.length > 0) {\n      readmeExcerpt = cleanLines.slice(0, 2).join(' ').slice(0, 260) + '...';\n    }\n  } catch (e) {\n    readmeExcerpt = 'README decoded fallback: ' + baseRepo.description;\n  }\n}\n\nconst hnHits = Array.isArray(hnNode.hits) ? hnNode.hits : [];\nconst topHnStory = hnHits[0] || null;\nconst hnTotalPoints = hnHits.reduce((acc, h) => acc + Number(h.points || 0), 0);\nconst hnTotalComments = hnHits.reduce((acc, h) => acc + Number(h.num_comments || 0), 0);\n\nreturn {\n  json: {\n    ...baseRepo,\n    readme_size_bytes: readmeNode.size || 0,\n    readme_excerpt: readmeExcerpt,\n    hn_mentions: hnHits.length,\n    hn_points: hnTotalPoints,\n    hn_comments: hnTotalComments,\n    hn_top_discussion: topHnStory ? `https://news.ycombinator.com/item?id=${topHnStory.objectID}` : 'No recent HN thread',\n    tier: baseRepo.stars > 1000 ? 'HIGH_PRIORITY_BREAKOUT' : 'EMERGING_WATCHLIST',\n    generated_at: new Date().toISOString()\n  }\n};"
      },
      "id": "b1a10007-1111-4111-8111-000000000007",
